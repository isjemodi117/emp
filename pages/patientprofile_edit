<!-- INLINE EDIT SCRIPT -->
<script>
document.querySelectorAll('.edit').forEach(icon => {
    icon.addEventListener('click', () => {
        const targetId = icon.dataset.target;
        const span = document.getElementById(targetId);

        const input = document.createElement('input');
        input.type = "text";
        input.value = span.textContent;
        input.classList.add("inline-edit");

        const save = document.createElement('i');
        save.classList.add("fa-solid", "fa-check", "save-icon");

        span.replaceWith(input);
        icon.replaceWith(save);

        save.addEventListener('click', () => {
            const newSpan = document.createElement('span');
            newSpan.id = targetId;
            newSpan.textContent = input.value;

            input.replaceWith(newSpan);
            save.replaceWith(icon);

            // Hier kan je later fetch() toevoegen voor database update
        });
    });
});
</script>

