.edit {
    margin-left: 8px;
    cursor: pointer;
    color: #2b7a78;
    transition: 0.2s;
}

.edit:hover {
    color: #195e5b;
}

.inline-edit {
    padding: 5px;
    margin-left: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

.save-icon {
    margin-left: 8px;
    cursor: pointer;
    color: #1b8f3a;
}

